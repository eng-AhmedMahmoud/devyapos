# Moving POS marketing site — environment
#
# Copy to `.env.local` for development. Every variable here is optional: with
# none of them set the site builds, runs, and still captures leads (see
# LEAD_FORWARD_URL below for what "captured" means in that case). Production
# is the Docker container on the Devya VPS: docker-compose.prod.yml sets
# LEAD_OUTBOX_DIR and the trial URL, and host-only values (the forward URL and
# token) go in `.env.production.local` beside the release there, never here.
# docs/architecture.md shows where each one is used.
#
# `.gitignore` ignores `.env*` and then negates this one file, so this template
# is tracked while every real `.env` stays out of the repo.

# ------------------------------------------------------------------ lead sink
# Where POST /api/lead forwards a validated lead. Unset is a supported state
# but a loud one: the lead goes to the outbox file (LEAD_OUTBOX_DIR below) and
# every such lead logs one error-level line, `[lead] NOT FORWARDED — kept in
# the outbox`, with its id, the reason and the outbox count — never the lead
# itself. `bash scripts/leads.sh status` shows what is waiting and
# `bash scripts/leads.sh pull <dir>` copies it off the server. Set this as
# soon as there is somewhere durable to put leads.
#
# The receiving endpoint must accept `POST application/json` with this body —
# the contract is defined by this site, not by an existing API:
#
#   {
#     "type": "lead",
#     "version": 1,
#     "id": "<uuid v4, stable across the single retry — dedupe on this>",
#     "site": "pos.devya.dev",   (a fixed sender tag; unchanged by the move to pos.movingsystems.tech)
#     "receivedAt": "<ISO 8601, rounded down to the minute>",
#     "lead": {
#       "name": "<string, 2..80>",
#       "restaurant": "<string, 2..120>",
#       "phone": "<E.164, always +20 1[0125]XXXXXXXX>",
#       "branches": <integer 1..500 | null>,
#       "message": "<string, <=1200 | null>",
#       "locale": "ar" | "en"
#     },
#     "attribution": {
#       "source": "<utm_source>", "medium": "<utm_medium>",
#       "campaign": "<utm_campaign>", "term": "<utm_term>",
#       "content": "<utm_content>",
#       "referrer": "<first-touch external referrer>",
#       "landingPath": "<path+query of first page in the session>",
#       "landingAt": "<ISO 8601, minute precision>"
#     },
#     "context": {
#       "userAgent": "<string | null>",
#       "referer": "<request referer | null>",
#       "country": "<string | null — client-supplied: nginx on the VPS sets no geo header>"
#     }
#   }
#
# Every `attribution` key is optional and browser-supplied — treat it as
# reporting data, never as a trust signal. Every string field is raw user
# input: escape it for wherever it lands (HTML, SQL, a sheet formula). A 2xx
# means accepted; any 4xx is a permanent rejection and is not retried; a 5xx,
# a timeout or a network error is retried once, then the lead goes to the
# outbox. `version` changes when the shape does.
# LEAD_FORWARD_URL=https://api.example.com/api/marketing/leads

# Optional bearer token sent as `Authorization: Bearer <token>` on the forward.
# LEAD_FORWARD_TOKEN=

# Optional per-attempt timeout in ms (default 4000). Two attempts max.
# LEAD_FORWARD_TIMEOUT_MS=4000

# Directory on the data volume for the lead outbox (leads-outbox.jsonl) and the
# consent receipts (consent-receipts.jsonl): append-only, owner-only files
# (lib/jsonl-sink.ts). `/data` in production (docker-compose.prod.yml). Unset,
# an unforwarded lead answers 503 and the form offers WhatsApp and email, and
# a consent receipt is kept only in the log.
# LEAD_OUTBOX_DIR=/tmp/devyapos-data

# Days an outbox entry is kept (default 365, the privacy policy's twelve months).
# LEAD_OUTBOX_RETENTION_DAYS=365

# Days a consent receipt is kept (default 365). The policy names no period for
# consent proof; a year outlives every consent, which expires after 180 days.
# CONSENT_RECEIPT_RETENTION_DAYS=365

# ------------------------------------------------------- accounting trial
# Where /accounting-trial posts a sign-up: the claim route of Devya's control
# plane (bohub-pos `ops-store`, POST /api/trial/claim). The browser posts there
# directly — not through this site — because the route limits sign-ups per
# address. Baked at BUILD time (NEXT_PUBLIC_), so changing it needs a rebuild.
#
# Unset is a supported state and the right one for development and previews:
# the page then shows "sign-ups are paused" with WhatsApp instead of posting,
# so a laptop can never claim a real trial stack. To try the form locally, run
# an ops-store on your machine and point this at it (and add this site's
# origin to that store's TRIAL_ALLOWED_ORIGINS).
#
# Production: https://ops-api.devya.dev/api/trial/claim (docker-compose.prod.yml
# passes it as a build arg).
# NEXT_PUBLIC_TRIAL_CLAIM_URL=
